# Copy to .env.local to run against your Supabase project locally. Without these the site runs as the demo.
# Both are public by design (the row rules in supabase/schema.sql protect the data). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
